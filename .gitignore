# Fortinet PDFs: ~500MB, redownloadable from sources.lock.json
sources/*.pdf
sources/*.part

# build intermediates
work/*/text.txt
work/*/tree.json
work/*/tree2.json
work/*/samples.json
work/*/config-examples.json
work/*.list
work/probe/
work/baseline/
# device captures: a `get system status` banner carries a serial number and a hostname,
# which are the operator's data and never ours to commit. The derived facts (model,
# firmware, build) go in captures.json instead.
work/live/

# device credentials -- the example file is committed, the real one never is
.env.devices

# local
.DS_Store
*.zip

# python bytecode from the tools importing each other
__pycache__/
*.pyc
