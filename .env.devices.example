# Lab devices for tools/capture_device.py.  Copy to .env.devices and chmod 600.
# .env.devices is gitignored and must never be committed.
#
# Plain dotenv, so a shell can source it too. One block per device.
# KIND is one of: fgt fsw faz fmg

DEVICES=fgt1,fsw1

FGT1_HOST=10.0.0.1
FGT1_KIND=fgt
FGT1_USER=admin
# Prefer a key, or leave both unset to use your ssh-agent:
FGT1_KEY=~/.ssh/id_ed25519
# A password works too -- it goes straight to the device's own prompt over the pty and
# never reaches a log, a file or an argument list. Labs are labs.
#FGT1_PASS=

FSW1_HOST=10.0.0.2
FSW1_KIND=fsw
FSW1_USER=admin
FSW1_KEY=~/.ssh/id_ed25519

# The account only needs to read. On FortiOS, an accprofile with `set cli-config disable`
# makes the DEVICE refuse writes rather than trusting this script to not attempt any --
# this walk never enters config mode, so it works fine under one.
